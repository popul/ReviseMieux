# ============================================================
# Révise Mieux — Clés API pour benchmarks LLM
# ============================================================
# Copier vers .env.bench et renseigner vos clés.
# Usage : make bench ALL=1
#         make bench MODELS=gpt-4o,claude-sonnet-4-6
#         make bench PROVIDER=openai
#
# Modèles disponibles : make bench-models

# --- Anthropic ---
# Modèles : claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX

# --- OpenAI ---
# Modèles : gpt-4o, gpt-4o-mini, o3-mini
OPENAI_API_KEY=sk-XXXXXXXX

# --- Google Gemini ---
# Modèles : gemini-2.5-flash, gemini-2.5-pro
GOOGLE_AI_API_KEY=AIzaXXXXXXXX

# --- Mistral ---
# Modèles : mistral-large-latest, mistral-small-latest
MISTRAL_API_KEY=XXXXXXXX

# --- DeepSeek ---
# Modèles : deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=sk-XXXXXXXX
