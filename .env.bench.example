# ============================================================
# Révise Mieux — Clés API pour benchmarks LLM
# ============================================================
# Copier vers .env.bench et renseigner vos clés.
# Usage : make bench ALL=1
#         make bench MODELS=gpt-4.1-mini,gemini-2.5-flash
#         make bench PROVIDER=openai
#
# Modèles disponibles : make bench-models

# --- Anthropic ---
# Modèles : claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX

# --- OpenAI ---
# Modèles : gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, o4-mini
OPENAI_API_KEY=sk-XXXXXXXX

# --- Google Gemini ---
# Modèles : gemini-2.5-flash, gemini-3.1-flash-lite
GOOGLE_AI_API_KEY=AIzaXXXXXXXX

# --- Mistral ---
# Modèles : mistral-small-latest, mistral-small-3.2, pixtral-12b, mistral-ocr-3
MISTRAL_API_KEY=XXXXXXXX

# --- DeepSeek ---
# Modèles : deepseek-v3.2
DEEPSEEK_API_KEY=sk-XXXXXXXX

# --- OpenRouter ---
# Modèles : qwen3.5-397b/9b, llama4-maverick/scout, step3.5-flash,
#           qwen3-vl-235b/32b, kimi-k2.5, minimax-m2.7, glm-4.5v, internvl3-78b
OPENROUTER_API_KEY=sk-or-XXXXXXXX

# --- LM Studio (local) ---
# Modèles : qwen3.6-35b-a3b, qwen3.5-35b-a3b, gemma4-26b-a4b, paddleocr-vl-1.5
# Lancer LM Studio avant le bench, les modèles doivent être chargés.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
