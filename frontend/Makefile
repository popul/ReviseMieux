# Frontend Makefile

.PHONY: build test lint clean dev install

# Install dependencies
install:
	npm install

# Build for production
build:
	npm run build

# Run tests
test:
	npm test

# Run linter
lint:
	npm run lint

# Run development server
dev:
	npm run dev

# Preview production build
preview:
	npm run preview

# Clean
clean:
	rm -rf node_modules dist
