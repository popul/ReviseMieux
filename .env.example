# Révise mieux - Environment Variables
# Copy this file to .env and fill in your values

# Database (used by docker-compose)
POSTGRES_USER=revisemieux
POSTGRES_PASSWORD=revisemieux
POSTGRES_DB=revisemieux

# Backend
DATABASE_URL=postgres://revisemieux:revisemieux@localhost:5432/revisemieux?sslmode=disable
PORT=8080

# LLM API Keys (at least one required for AI features)
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=

# Optional: OCR provider (defaults to OpenAI Vision)
OCR_PROVIDER=openai

# Quotas journaliers (optionnel, valeurs par défaut si non spécifié)
QUOTA_OCR=50
QUOTA_GENERATION=100
