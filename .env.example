# ============================================================
# Révise Mieux — Variables d'environnement
# ============================================================
# Copier vers .env et adapter les valeurs

# --- API Server ---
PORT=8080
GIN_MODE=debug                  # debug | release | test

# --- PostgreSQL ---
POSTGRES_USER=revisemieux
POSTGRES_PASSWORD=revisemieux
POSTGRES_DB=revisemieux
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://revisemieux:revisemieux@localhost:5432/revisemieux?sslmode=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (dev) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=revisemieux
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- LLM API Keys (benchmark + structuration) ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-XXXXXXXX
GOOGLE_AI_API_KEY=AIzaXXXXXXXX
MISTRAL_API_KEY=XXXXXXXX
DEEPSEEK_API_KEY=sk-XXXXXXXX

# --- JWT (usage local Lot 0) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
